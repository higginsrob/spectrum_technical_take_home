# ollama (default) or openai
LLM_PROVIDER=ollama

# Shared Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Agent: customer-facing reply. Think is off because Python already picks the
# next field; Gemma 4 thinking only adds TTFT. Temp 0.3 keeps greetings warm
# without inventing slots. Keep_alive forever when both models fit.
OLLAMA_AGENT_MODEL=gemma4:26b
OLLAMA_AGENT_THINK=off          # on | low | medium | high | off
OLLAMA_AGENT_NUM_CTX=8192      # 1024 | 2048 | 4096 | 8192 | 16384 | 32768 | 65536 | 131072 | 262144
OLLAMA_AGENT_KEEP_ALIVE=-1     # -1/forever | 4 minutes | 15 minutes | 1 hour
OLLAMA_AGENT_TEMPERATURE=0.3
OLLAMA_AGENT_NUM_PREDICT=512
# OLLAMA_AGENT_TOP_P=0.9
# OLLAMA_AGENT_TOP_K=40
# OLLAMA_AGENT_REPEAT_PENALTY=1.1
# OLLAMA_AGENT_SEED=42

# Classify: extract + classify JSON. Small model, think off, temp 0. Point this
# at gemma4:e4b when the agent is large. Keep_alive -1 if it fits with the
# agent; use 15m if VRAM is tight.
OLLAMA_CLASSIFY_MODEL=gemma4:e4b
OLLAMA_CLASSIFY_THINK=off      # on | low | medium | high | off
OLLAMA_CLASSIFY_NUM_CTX=4096   # 1024 | 2048 | 4096 | 8192 | 16384 | 32768 | 65536 | 131072 | 262144
OLLAMA_CLASSIFY_KEEP_ALIVE=-1  # -1/forever | 4 minutes | 15 minutes | 1 hour
OLLAMA_CLASSIFY_TEMPERATURE=0
OLLAMA_CLASSIFY_NUM_PREDICT=256
# OLLAMA_CLASSIFY_TOP_P=0.9
# OLLAMA_CLASSIFY_TOP_K=40
# OLLAMA_CLASSIFY_REPEAT_PENALTY=1.1
# OLLAMA_CLASSIFY_SEED=42

# OpenAI-compatible fallback (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4o-mini
OPENAI_CLASSIFY_MODEL=gpt-4o-mini

# Optional LangSmith tracing (not required to run)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=support-intake-agent
